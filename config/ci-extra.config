# ===== 由 CI 追加（不属于原始 x86_64.config）=====

# OpenClash 已经是官方包 luci-app-openclash 的 DEPENDS，但这里再钉一遍，
# 防止上游改依赖后 defconfig 把它们裁掉（缺了插件能装不能跑）。
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y

# ===== 关闭 Ruby YJIT（直接决定单次构建 3 小时还是 5 小时）=====
# x86_64 上 RUBY_ENABLE_YJIT 默认 =y，而 feeds/packages/lang/ruby/Makefile 里：
#   PKG_BUILD_DEPENDS:=ruby/host RUBY_ENABLE_YJIT:rust/host
# YJIT 一开就要先编 rust/host，rustc 再从源码把整套 LLVM 编一遍（3898 个 cmake 目标），
# 4 核 runner 上多耗 2 小时以上，极易撞 350 分钟超时。
# OpenClash 只用 ruby 做 YAML 解析与 PStore，不需要 YJIT。
# CONFIG_RUBY_ENABLE_YJIT is not set
